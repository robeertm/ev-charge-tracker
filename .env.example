# Copy to .env and fill in. deploy/docker-install.sh does this for you.

# Signs the session cookie. Any long random string; generate one with:
#   openssl rand -hex 32
SECRET_KEY=

# Optional. A free ENTSO-E token turns on the real CO2 intensity of your
# grid instead of a flat average: https://transparency.entsoe.eu/
ENTSOE_API_KEY=

# Optional. The port the app is reachable on, and your time zone.
EV_PORT=7654
TZ=Europe/Berlin
